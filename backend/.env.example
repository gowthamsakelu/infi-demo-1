APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Hotel / activity search in the itinerary builder (Google Places API (New)). Optional: without a key the builder
# searches the built-in demo places instead. The key is only ever used on the server.
GOOGLE_PLACES_API_KEY=
# auto = Google when the key is set, otherwise built-in demo places (database/data/demo-places.json); or force google / demo
PLACES_PROVIDER=auto

# Rayna B2B Tour API (mode: mock or live)
RAYNA_MODE=mock
RAYNA_BASE_URL=https://api.raynab2b.com
RAYNA_TOKEN=
RAYNA_TIMEOUT=30
RAYNA_IMAGE_BASE=https://d2cazmkfw8kdtj.cloudfront.net

# Sign in. While DEMO_LOGIN is true the sign-in page has a "Press to log in" button (no password). Turn it off when real accounts exist.
DEMO_LOGIN=true
# Optional: seeding creates a real account with these (leave empty to skip).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Catalog pages (Destinations, Tour Packages, Transport, Stays, Adventures, Banners, Blogs, Settings) show the sample data in database/dummy.
# Set to false to read the real tables.
USE_DUMMY_DATA=true
